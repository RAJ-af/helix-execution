# HELIX AI - ANDROID ENVIRONMENT CONFIGURATION

# The base URL of your FastAPI backend.
# Use http://10.0.2.2:8000/api/v1/ for Android Emulator.
# Use your computer's local IP (e.g., http://192.168.1.50:8000/api/v1/) for real devices.
BASE_URL=http://10.0.2.2:8000/api/v1/

# If you want to enable tool execution features, ensure the backend has these.
TAVILY_API_KEY=your_tavily_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Toggle Debug Logging (true/false)
ENABLE_DEBUG_LOGGING=true
